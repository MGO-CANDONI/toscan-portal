rules_version = '2';

// TOSCAN Portal — Firestore security rules
// Deploy: firebase deploy --only firestore:rules
//
// Model: the web app READS; Cloud Functions WRITE. Roles come from custom
// claims set by the functions (token.role = student | staff | admin, and
// token.studentId for students). Nobody, including administrators, can write
// program, document or payroll records directly from a browser, so every change
// is validated and recorded in the audit log by the server.
service cloud.firestore {
  match /databases/{database}/documents {

    // Anonymous sign-ins (used only to upload a bidbook from the public page) count as signed out.
    function signedIn() { return request.auth != null && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isAdmin() { return role() == 'admin'; }
    function isStaff() { return role() in ['staff', 'admin']; }
    function isStudent(sid) { return role() == 'student' && request.auth.token.get('studentId', '') == sid; }
    function ownsRecord() { return isStudent(resource.data.studentId); }

    // Login accounts: you see your own; staff see all.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
    }

    // Student master records
    match /students/{studentId} {
      allow read: if isStaff() || isStudent(studentId);
    }

    // Records that belong to one student (each carries studentId)
    match /studentAcademicHistory/{id} { allow read: if isStaff() || ownsRecord(); }
    match /submissions/{id}            { allow read: if isStaff() || ownsRecord(); }
    match /eligibility/{id}            { allow read: if isStaff() || ownsRecord(); }
    match /allowances/{id}             { allow read: if isStaff() || ownsRecord(); }
    match /payrollItems/{id}           { allow read: if isStaff() || ownsRecord(); }
    match /historicalPayments/{id}     { allow read: if isStaff() || ownsRecord(); }
    match /programStatusHistory/{id}   { allow read: if isStaff() || ownsRecord(); }
    match /deadlineExtensions/{id}     { allow read: if isStaff() || ownsRecord(); }

    // TOSCAN search applications (written only by the server)
    match /searchApplications/{id} { allow read: if isStaff(); }
    // Public form settings for the sign-in page (no personal data)
    match /publicConfig/{id} { allow read: if true; }

    // Staff-only records
    match /payrolls/{id} { allow read: if isStaff(); }
    match /imports/{id}  { allow read: if isStaff(); }
    match /auditLogs/{id} { allow read: if isAdmin(); }

    // Configuration (read by every signed-in user; changed only through saveMasterData)
    match /settings/{id}             { allow read: if signedIn(); }
    match /academicYears/{id}        { allow read: if signedIn(); }
    match /schools/{id}              { allow read: if true; } // school names are shown on the public application form
    match /documentRequirements/{id} { allow read: if signedIn(); }
    match /allowanceTypes/{id}       { allow read: if signedIn(); }

    // Notifications: read your own and mark them read. Nothing else.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;
    }

    // Old-portal collections: preserved, read-only for administrators.
    match /archivedStudents/{id}   { allow read: if isAdmin(); }
    match /applications/{id}       { allow read: if isAdmin(); }
    match /logins/{id}             { allow read: if isAdmin(); }
    match /attachmentUpdates/{id}  { allow read: if isAdmin(); }
    match /latinHonorUpdates/{id}  { allow read: if isAdmin(); }
    match /top20Submissions/{id}   { allow read: if isAdmin(); }
    match /sync_applications/{id}  { allow read: if isAdmin(); }
    match /sync_archivedApplications/{id} { allow read: if isAdmin(); }
    match /sync_accessRequests/{id} { allow read: if isAdmin(); }
    match /sync_config/{id}        { allow read: if isAdmin(); }

    // Everything else (mail queue, counters, …) is server-only: no rule = denied.
  }
}

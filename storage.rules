rules_version = '2';

// TOSCAN Portal — Cloud Storage security rules
// Deploy with:  firebase deploy --only storage
// These rules read the user's record in Firestore. The first deploy asks you to
// allow Storage to read Firestore — answer yes.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function bootstrapAdmin() {
      return signedIn()
        && request.auth.token.email in ['toscan.candoni@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function profilePath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function approved() {
      return signedIn() && firestore.exists(profilePath())
        && firestore.get(profilePath()).data.status == 'approved';
    }
    function isAdmin() { return bootstrapAdmin() || (approved() && firestore.get(profilePath()).data.role == 'admin'); }
    function isStaff() { return isAdmin() || (approved() && firestore.get(profilePath()).data.role == 'staff'); }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Files uploaded from a user's dashboard (15 MB limit)
    match /uploads/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid && approved()
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Profile pictures (images up to 3 MB; the app resizes them first)
    match /profile/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}

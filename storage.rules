rules_version = '2';

// TOSCAN Portal — Cloud Storage security rules
// Deploy: firebase deploy --only storage
//
// No file can be overwritten or deleted from a browser. Rejected uploads are
// cleaned up by the server; approved documents stay on file permanently.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isAdmin() { return role() == 'admin'; }
    function isStaff() { return role() in ['staff', 'admin']; }
    function isStudent(sid) { return role() == 'student' && request.auth.token.get('studentId', '') == sid; }
    function sizeUnder(mb) { return request.resource.size < mb * 1024 * 1024; }

    // Student documents: documents/{studentId}/{submissionId}/{fileName}
    match /documents/{studentId}/{submissionId}/{fileName} {
      allow read: if isStaff() || isStudent(studentId);
      allow create: if isStudent(studentId)
        && submissionId.matches('^[A-Za-z0-9]{10,40}$')
        && sizeUnder(15)
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    // Profile photos: photos/{uid}/{fileName}
    match /photos/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if signedIn() && request.auth.uid == uid && role() != ''
        && sizeUnder(3) && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if false;
    }

    // Supporting files for historical imports
    match /historical/{importId}/{fileName} {
      allow read: if isStaff();
      allow create: if isStaff() && sizeUnder(25)
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png)|text/csv|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|application/vnd.ms-excel');
      allow update, delete: if false;
    }

    // Bidbooks from TOSCAN search finalists: searchApplications/{ref}/{uid}/{fileName}.
    // Uploaded with an anonymous sign-in from the public page; the server checks the
    // reference number, access code and finalist status before accepting the file.
    match /searchApplications/{appRef}/{uid}/{fileName} {
      allow read: if isStaff();
      allow create: if request.auth != null && request.auth.uid == uid
        && appRef.matches('^TS[0-9]{4}-[0-9]{4,6}$')
        && fileName.matches('^[A-Za-z0-9_.-]{1,80}$')
        && sizeUnder(25) && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }

    // Login-page image (public)
    match /branding/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && sizeUnder(5) && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if false;
    }

    // Files from the old portal and the October redesign: preserved, read-only.
    match /students/{rest=**}         { allow read: if isStaff(); }
    match /latinHonor/{rest=**}       { allow read: if isStaff(); }
    match /top20Submissions/{rest=**} { allow read: if isStaff(); }
    match /archives/{rest=**}         { allow read: if isAdmin(); }
    match /backups/{rest=**}          { allow read: if isAdmin(); }
    match /uploads/{rest=**}          { allow read: if isAdmin(); }
    match /profile/{rest=**}          { allow read: if isAdmin(); }
  }
}
